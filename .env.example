# =====================================================================
# Healthcare Portfolio Intelligence - Configuration
# =====================================================================

# 1. GitHub Authentication
# Generate a Personal Access Token at https://github.com/settings/tokens
# Scopes required: 'repo' (Full control of private repositories)
# If under an organization, ensure 'read:org' scope is also checked.
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here

# Target type: "org", "user", or "viewer"
# Use "org" if scanning an organization's repos (e.g., hospital group)
# Use "user" if scanning another specific user's public/accessible repos
# Use "viewer" to scan all repos accessible to the authenticated token
GITHUB_TARGET_TYPE=viewer

# Target organization or username (Leave empty if GITHUB_TARGET_TYPE=viewer)
GITHUB_TARGET_OWNER=

# Optional: Comma-separated list of repository names to skip
GITHUB_EXCLUDE_REPOS=.github,sandbox-test

# 2. Database & Storage
DATABASE_PATH=healthcare_portfolio_catalog.db

# 3. Performance & Concurrency
GRAPHQL_PAGE_SIZE=100
MAX_RETRIES=5
RETRY_BACKOFF_FACTOR=2.0
RATE_LIMIT_SAFETY_MARGIN=50

# 4. LLM Configuration (For Phase 3)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
OPENAI_API_KEY=

# 5. Continuous Sync & Webhook Receiver (Phase 5)
# Set a shared secret string for GitHub Webhook HMAC-SHA256 signature verification
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_PORT=9000
SYNC_INTERVAL_HOURS=6


